{
  "name": "Inkwave PWA",
  "short_name": "Inkwave PWA",
  "description": "A calm writing surface for serious thinking.",
  "start_url": "/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "shortcuts": [
    {
      "name": "New doc",
      "short_name": "New doc",
      "description": "Open the next available Inkwave document in another window.",
      "url": "/?new-window=1",
      "icons": [
        { "src": "/icon-192.png?v=white-bg-1", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ],
  "background_color": "#FBF5EC",
  "theme_color": "#141313",
  "icons": [
    { "src": "/icon-192.png?v=white-bg-1", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png?v=white-bg-1", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/maskable-192.png?v=white-bg-1", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/maskable-512.png?v=white-bg-1", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/?file-launch=1",
      "accept": { "application/x-inkwave-studio": [".studio", ".inkwave"] },
      "icons": [{ "src": "/icon-192.png?v=white-bg-1", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "multiple-clients"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
